# =============================================================================
# LOCKUPHQ DR Writer — environment variables
# =============================================================================
# On Replit, set these in the Secrets panel (Tools -> Secrets). Replit injects
# secrets into process.env automatically, so you do NOT need a real .env file
# in the Repl. This file only documents what each variable does.
# NEVER commit real values. NEVER paste a real key into source or docs.
# -----------------------------------------------------------------------------

# REQUIRED for live AI drafting. Get a key from the Anthropic console.
# The app calls Anthropic's Messages API directly over fetch(); no SDK.
# NOTE: a previously committed key was leaked and REDACTED from this repo —
# rotate it in the Anthropic console and use the NEW key here.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# REQUIRED for live drafting: turn on live AI (default is deterministic "stub").
# Equivalent to passing --ai=live on the command line. With AI_MODE=live set,
# the app refuses to start unless ANTHROPIC_API_KEY is present (fail closed).
AI_MODE=live

# REQUIRED before the FIRST boot to create the admin account.
# On a fresh data dir (no users.json yet), the app provisions ONE system_admin
# from these two values. Set them in Secrets BEFORE starting the app the first
# time. If left unset, no admin exists and admin-only routes (kill switch, etc.)
# cannot be used until an admin is provisioned on a fresh data dir.
ADMIN_USERNAME=choose_an_admin_username
ADMIN_PASSWORD=choose_a_strong_admin_password

# REQUIRED: the browser origin allowed to call the API (CORS). Set to the
# deployed domain, e.g. https://your-repl-name.replit.app (or a custom domain).
# Requests from any other origin fail CORS silently in the browser.
LOCKUPHQ_ALLOWED_ORIGIN=https://your-deployed-domain.example

# DO NOT SET on Replit — the platform assigns PORT and the app reads it
# automatically (falls back to 5177 only for local dev). Hardcoding it will
# break the deployment's health check.
# PORT=

# -----------------------------------------------------------------------------
# OPTIONAL — Claude tuning (safe to leave unset; the app uses frozen defaults).
# -----------------------------------------------------------------------------
# CLAUDE_MODEL=
# CLAUDE_MAX_TOKENS=
# CLAUDE_TEMPERATURE=
# CLAUDE_TIMEOUT_MS=

# OPTIONAL — debugging only. Leave unset in production.
# DEBUG_CLAUDE_RAW=
# LOCKUPHQ_PUBLIC_DEMO_MODE=
